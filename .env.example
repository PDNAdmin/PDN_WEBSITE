# Resend (booking emails)
RESEND_API_KEY=
BOOKING_TO_EMAIL=
# Must be on a domain verified in Resend (until then: onboarding@resend.dev, which only delivers to the Resend account owner)
BOOKING_FROM_EMAIL=

# Optional: shared rate limit across serverless instances (falls back to in-memory)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: force token pills on/off (default: on everywhere except Vercel production)
# NEXT_PUBLIC_SHOW_TOKENS=true
