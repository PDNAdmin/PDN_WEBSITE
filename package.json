{
  "name": "pdn-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/setup-fonts.mjs && node scripts/copy-brand.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/setup-fonts.mjs && node scripts/copy-brand.mjs",
    "build": "next build",
    "start": "next start",
    "assets": "node scripts/process-assets.mjs",
    "grain": "node scripts/make-grain.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "check:tokens": "node scripts/check-tokens.mjs",
    "showreel:studio": "echo \"Remotion project is Phase 3 (docs/08). Not set up yet.\" && exit 1",
    "showreel:render": "echo \"Remotion project is Phase 3 (docs/08). Not set up yet.\" && exit 1"
  },
  "packageManager": "pnpm@12.18.0",
  "dependencies": {
    "lenis": "^1.3.27",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "resend": "^6.38.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.14.0",
    "eslint-config-next": "16.4.6",
    "postcss": "^8.5.32",
    "prettier": "^3.10.1",
    "sharp": "^0.35.5",
    "tailwindcss": "4.3.5",
    "typescript": "^5.9.3"
  },
  "browserslist": [
    "chrome >= 109",
    "edge >= 109",
    "firefox >= 115",
    "safari >= 15.4",
    "ios_saf >= 15.4",
    "samsung >= 21"
  ]
}
